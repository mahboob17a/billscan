# Copy to .env and fill in from Supabase → Project Settings → API.
# These two values are public (safe inside the app). The OpenAI key is NOT set here;
# it is stored only on the server:  supabase secrets set OPENAI_API_KEY=sk-...
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
