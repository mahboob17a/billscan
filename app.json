{
  "expo": {
    "name": "BillScan",
    "slug": "billscan",
    "scheme": "billscan",
    "version": "0.5.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F4F2FB",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.daryas.billscan",
      "infoPlist": {
        "NSFaceIDUsageDescription": "BillScan uses Face ID to unlock the app quickly after you have signed in.",
        "NSCameraUsageDescription": "BillScan uses the camera to scan purchase bills."
      }
    },
    "android": {
      "package": "com.daryas.billscan",
      "versionCode": 6,
      "adaptiveIcon": {
        "backgroundColor": "#1B2230",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B2230",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "BillScan uses Face ID to unlock the app quickly after you have signed in."
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "BillScan opens your photos so you can add a bill you already photographed.",
          "microphonePermission": false
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "BillScan uses the camera to scan your purchase bills."
        }
      ],
      "expo-sharing"
    ]
  }
}
